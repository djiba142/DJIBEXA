POSTGRES_DB=nexora
POSTGRES_USER=nexora
POSTGRES_PASSWORD=replace-this-local-password

DB_ENGINE=postgresql
DB_NAME=nexora
DB_USER=nexora
DB_PASSWORD=replace-this-local-password
DB_HOST=db
DB_PORT=5432
GUNICORN_WORKERS=2

DJANGO_ENV=development
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=development-only-change-before-any-public-deployment
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_TRUST_X_FORWARDED_PROTO=false
DJANGO_CROSS_SITE_COOKIES=false

FRONTEND_BASE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@localhost

VITE_API_BASE_URL=http://localhost:8000/api/v1

